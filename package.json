{
  "name": "numaliving-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:site": "bash scripts/build-site.sh",
    "serve:pages": "node scripts/serve-pages.mjs --root _site --port ${E2E_PORT-4173}",
    "css": "tailwindcss -i _tailwind/site.css -o assets/css/site.css --minify",
    "css:check": "bash scripts/check-css.sh",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "bash scripts/check-local.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/cli": "^4.3.4",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
