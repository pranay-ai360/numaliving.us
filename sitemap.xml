---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for entry in site.data.pages %}
  <url><loc>{{ site.url }}{{ entry.url }}</loc><lastmod>{{ site.data.site.last_updated }}</lastmod></url>
{%- endfor -%}
{%- assign projects = site.projects | sort: "order" -%}
{%- for project in projects %}
  <url><loc>{{ site.url }}{{ project.url }}</loc><lastmod>{{ site.data.site.last_updated }}</lastmod></url>
{%- endfor %}
</urlset>
